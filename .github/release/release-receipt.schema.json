{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rcdigital.example/schemas/release-receipt-1.0.0.json",
  "title": "RC Digital Release Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "stage",
    "predecessor",
    "commit_sha",
    "artifact_digests",
    "migration_range",
    "required_checks",
    "report_hashes",
    "target_environment",
    "feature_flag_state",
    "approvals",
    "timestamps",
    "exceptions",
    "rollback_references",
    "attestation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_version": {
      "const": "1.0.0"
    },
    "stage": {
      "enum": ["schema", "functions", "frontend", "dormant", "enable"]
    },
    "predecessor": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["stage", "receipt_id", "subject_digest"],
      "properties": {
        "stage": {
          "enum": ["schema", "functions", "frontend", "dormant"]
        },
        "receipt_id": { "$ref": "#/$defs/sha256" },
        "subject_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "artifacts"],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "migration_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "hashes"],
      "properties": {
        "from": { "type": ["string", "null"] },
        "to": { "type": "string", "minLength": 1 },
        "hashes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/namedHash" }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "result"],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "result": { "enum": ["success", "failure"] },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "report_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests", "security"],
      "properties": {
        "tests": { "$ref": "#/$defs/sha256" },
        "security": { "$ref": "#/$defs/sha256" }
      }
    },
    "target_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "provider_target"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "provider_target": { "type": "string", "minLength": 1 }
      }
    },
    "feature_flag_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "state"],
      "properties": {
        "feature": { "type": ["string", "null"] },
        "state": { "enum": ["not_applicable", "disabled", "dormant", "enabled"] }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor", "role", "approved_at", "deployment_id"],
        "properties": {
          "actor": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string", "format": "date-time" },
          "deployment_id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_at", "verified_at"],
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "authenticated_owner",
          "linked_issue",
          "affected_scope",
          "rationale",
          "compensating_controls",
          "expires_at",
          "policy_version"
        ],
        "properties": {
          "class": {
            "enum": ["unrelated_nonfinancial", "classified_infrastructure"]
          },
          "authenticated_owner": { "type": "string", "minLength": 1 },
          "linked_issue": { "type": "string", "minLength": 1 },
          "affected_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rationale": { "type": "string", "minLength": 1 },
          "compensating_controls": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "expires_at": { "type": "string", "format": "date-time" },
          "policy_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "rollback_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "subject_digest", "reference"],
      "properties": {
        "provider": { "const": "github_oidc" },
        "subject_digest": { "$ref": "#/$defs/sha256" },
        "reference": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "namedHash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
